# Куда падают заявки с формы. Без этой переменной заявка только пишется в лог сервера.
LEAD_EMAIL_TO=
# SMTP российского провайдера — заявки с персональными данными не должны уходить за периметр РФ.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Вебхук CRM. Заказчик CRM ещё выбирает — заполнить, когда определится.
CRM_WEBHOOK_URL=
# Заявки в Telegram. Токен бота из @BotFather.
# В репозиторий не коммитится: репозиторий публичный, а токен даёт полный
# доступ к боту — по GitHub ходят сканеры, которые ищут ровно такие строки.
TELEGRAM_BOT_TOKEN=
# Кому приходят заявки: id чатов через запятую. Получить свой id — написать
# боту @userinfobot. Заявку получает каждый из списка: если у одного нет сети,
# её увидит второй.
TELEGRAM_CHAT_IDS=

# Номер счётчика Яндекс.Метрики.
NEXT_PUBLIC_YANDEX_METRIKA_ID=
# Ключ Яндекс.Карт для карты объектов и офиса.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
