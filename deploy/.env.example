# Заполняется на сервере, в репозиторий не попадает (см. .gitignore).
# Токен бота @armmaxrequestsbot из @BotFather.
TELEGRAM_BOT_TOKEN=
# Кому приходят заявки: id чатов через запятую.
TELEGRAM_CHAT_IDS=

# Адрес Telegram Bot API. Пусто — официальный api.telegram.org.
# С российских площадок его подсети закрыты, поэтому на сервере сюда
# ставится свой прокси, например https://tg.<ваш-домен>.workers.dev
TELEGRAM_API_BASE=
