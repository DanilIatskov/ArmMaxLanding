# Внешний вход: TLS, сжатие и заголовки безопасности.
#
# Сертификат Caddy получает и продлевает сам, домен для этого должен
# резолвиться на этот сервер — A-запись armmax.ltd и www.armmax.ltd.
# MX и TXT домена остаются на почтовом хостинге Рег.ру и здесь ни при чём.

armmax.ltd {
	encode zstd gzip

	header {
		# Год HSTS. Браузер, однажды открывший сайт по https, больше не пойдёт
		# по http вовсе — это закрывает подмену на этапе первого запроса в
		# публичной сети. includeSubDomains не ставим: поддомены домена заняты
		# почтой, и загонять их в политику сайта незачем.
		Strict-Transport-Security "max-age=31536000"
		# Браузер не угадывает тип файла по содержимому: загруженный «документ»,
		# который на деле скрипт, не исполнится.
		X-Content-Type-Options nosniff
		# Сайт нельзя вставить во фрейм на чужой странице — так делают, когда
		# подделывают форму заявки поверх настоящей.
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Версия сервера наружу не нужна: это подсказка, каким эксплойтом пробовать.
		-Server
	}

	reverse_proxy site:3000
}

# www — постоянным редиректом на основной домен: sitemap, canonical и
# микроразметка указывают на адрес без www, и две живые копии сайта
# конкурировали бы в выдаче сами с собой.
www.armmax.ltd {
	redir https://armmax.ltd{uri} permanent
}
